{
  "name": "subsub",
  "version": "0.5.0",
  "description": "Sub-Sub: a Zotero librarian and research assistant in the terminal, built on pi",
  "type": "module",
  "license": "MIT",
  "author": "Tiago Jacinto",
  "keywords": [
    "pi-package",
    "zotero",
    "research",
    "literature",
    "librarian",
    "mcp",
    "obsidian"
  ],
  "pi": {
    "extensions": [
      "./extensions/subsub.ts"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/unit.test.ts",
    "test:e2e": "node --test test/e2e.test.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "subsub": "bin/subsub.js",
    "subsub-bench": "bin/subsub-bench.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist",
    "docs",
    "extensions",
    "prompts",
    "roles",
    "scripts",
    "src",
    "templates",
    "themes"
  ],
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3"
  },
  "homepage": "https://subsub.tiagojacinto.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagojct/subsub.git"
  },
  "bugs": {
    "url": "https://github.com/tiagojct/subsub/issues"
  }
}
