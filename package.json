{
  "name": "subsub",
  "version": "0.4.0",
  "description": "Sub-Sub: a Zotero librarian and research assistant for the pi coding agent",
  "type": "module",
  "license": "MIT",
  "author": "Tiago Jacinto",
  "keywords": [
    "pi-package",
    "zotero",
    "research"
  ],
  "pi": {
    "extensions": [
      "./extensions/subsub.ts"
    ],
    "prompts": [
      "./prompts/*.md"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "^1.30.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/unit.test.ts",
    "test:e2e": "node --test test/e2e.test.ts"
  },
  "bin": {
    "subsub": "bin/subsub.js",
    "subsub-bench": "bin/subsub-bench.js"
  },
  "files": [
    "README.md",
    "bin",
    "docs",
    "extensions",
    "prompts",
    "roles",
    "scripts",
    "src",
    "themes"
  ],
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.9.3"
  }
}
