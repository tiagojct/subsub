<!doctype html>
<html lang="{{ lang or 'en' }}" data-theme="light">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }} — A Librarian &amp; Research Assistant for Zotero</title>
	<meta name="description" content="{{ description or site.description }}">
	{% if noindex %}<meta name="robots" content="noindex">
	{% endif %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	<meta name="color-scheme" content="light dark">
	<meta property="og:title" content="{{ title or site.title }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:url" content="{{ site.url }}{{ page.url }}">
	<meta property="og:type" content="website">
	<link rel="icon" href="/assets/favicon.svg?v={{ assetVersion }}" type="image/svg+xml">

	<!-- Preconnect Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&display=swap" rel="stylesheet">

	<link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
	<script>
		// Immediate theme initialization to prevent Flash of Unstyled Content
		(function () {
			try {
				var saved = localStorage.getItem("subsub-theme");
				var theme = saved || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.setAttribute("data-theme", theme);
			} catch (e) {}
		})();
	</script>
	<script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
</head>
<body class="{{ bodyClass or 'page' }}">
	<a class="skip" href="#main">{{ "Saltar para o conteúdo" if lang == "pt-PT" else "Skip to content" }}</a>
	
	<header class="site-header">
		<div class="header-inner">
			<a class="brand-wrap" href="/" aria-label="Sub-Sub Home">
				<span class="brand-title">Sub-Sub</span>
				<span class="brand-tag">v{{ release.version }}</span>
			</a>

			<nav aria-label="Main Navigation">
				<ul class="nav-links">
				{%- for item in nav %}
					<li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
				{%- endfor %}
				</ul>
			</nav>

			<div class="header-actions">
				<a href="{{ site.repo }}" class="github-btn" target="_blank" rel="noopener noreferrer">GitHub</a>
				<button type="button" class="theme-btn" id="theme-toggle" aria-label="Toggle light or dark theme">Appearance</button>
			</div>
		</div>
	</header>

	{% if bodyClass == "home" %}
		<main id="main">
			{{ content | safe }}
		</main>
	{% else %}
		<main id="main" class="page-container">
			{%- if title and not hideTitle %}
			<header class="page-header">
				{% if eyebrow %}<p class="page-eyebrow">{{ eyebrow }}</p>{% endif %}
				<h1 class="page-title">{{ title }}</h1>
				{% if lead %}<p class="page-lead">{{ lead }}</p>{% endif %}
			</header>
			{%- endif %}
			<article class="prose">
				{{ content | safe }}
			</article>
		</main>
	{% endif %}

	<footer class="site-footer">
		<div class="footer-inner">
			<div class="colophon-top">
				<div class="colophon-desc">
					<strong>Sub-Sub</strong> is an assistant for Zotero. It previews every library change, journals all edits with full undo, and writes literature notes in plain Markdown.
				</div>
				<ul class="colophon-links">
					<li><a href="/install/">Install</a></li>
					<li><a href="/guide/">Guide</a></li>
					<li><a href="/profiles/">Profiles</a></li>
					<li><a href="/privacy/">Privacy</a></li>
					<li><a href="/models/">Models</a></li>
					<li><a href="/about/">About</a></li>
					<li><a href="{{ site.repo }}" target="_blank" rel="noopener">Source Code</a></li>
				</ul>
			</div>
			<div class="colophon-bottom">
				<div>MIT Licence · Made by <a href="/about/">Tiago Jacinto</a></div>
				<div class="version-note">subsub {{ release.version }} · server {{ release.server }} · pi {{ release.pi }}</div>
			</div>
		</div>
	</footer>
</body>
</html>
