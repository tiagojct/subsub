{%- set pt = lang == "pt-PT" -%}
<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title and title != site.title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}: a librarian and research assistant for Zotero{% endif %}</title>
	<meta name="description" content="{{ description or site.description }}">
	{% if noindex %}<meta name="robots" content="noindex">
	{% endif %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	<meta name="color-scheme" content="light dark">
	<meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)">
	<meta property="og:title" content="{{ title or site.title }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:url" content="{{ site.url }}{{ page.url }}">
	<meta property="og:type" content="website">
	<meta property="og:image" content="{{ site.url }}/assets/img/web-view-light.webp">
	<link rel="icon" href="/assets/favicon.svg?v={{ assetVersion }}" type="image/svg+xml">
	<link rel="preload" href="/assets/fonts/IBMPlexSans.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/assets/fonts/IBMPlexSerif.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
	<script>
		// Set the theme before the first paint: the saved choice, or the system setting.
		try {
			var saved = localStorage.getItem("subsub-site-theme");
			if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
		} catch (e) {}
	</script>
	<script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
</head>
<body class="{{ bodyClass or 'page' }}">
	<a class="skip" href="#main">{{ "Saltar para o conteúdo" if pt else "Skip to content" }}</a>

	<header class="site-header">
		<div class="wrap header-inner">
			<a class="brand" href="/">
				<svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M6.5 9h7M6.5 12h11"/><circle cx="12" cy="16" r="1.1"/></svg>
				<span>Sub<span class="hyphen">-</span>Sub</span>
			</a>
			<nav class="nav" aria-label="{{ 'Menu principal' if pt else 'Main' }}">
				<ul>
				{%- for item in nav %}
					<li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
			<div class="header-tools">
				<a class="tool-link" href="{{ site.repo }}" rel="noopener">GitHub</a>
				<button type="button" class="theme-btn" id="theme-toggle" aria-label="{{ 'Mudar tema' if pt else 'Switch theme' }}">
					<svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
					<svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
				</button>
			</div>
		</div>
	</header>

	{% if bodyClass == "home" %}
		<main id="main">
			{{ content | safe }}
		</main>
	{% else %}
		<main id="main" class="wrap doc">
			{%- if title and not hideTitle %}
			<header class="doc-header">
				{% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
				<h1>{{ title }}</h1>
				{% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
			</header>
			{%- endif %}
			<div class="doc-body">
				<article class="prose">
					{{ content | safe }}
				</article>
				<aside class="toc" id="toc" hidden>
					<p class="toc-title">{{ "Nesta página" if pt else "On this page" }}</p>
					<ol></ol>
				</aside>
			</div>
		</main>
	{% endif %}

	<footer class="site-footer">
		<div class="wrap footer-inner">
			<div class="footer-about">
				<a class="brand" href="/">
					<svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M6.5 9h7M6.5 12h11"/><circle cx="12" cy="16" r="1.1"/></svg>
					<span>Sub<span class="hyphen">-</span>Sub</span>
				</a>
				<p>A librarian and research assistant for Zotero. Open source, MIT licence. Made by <a href="/about/">Tiago Jacinto</a> at the Faculty of Medicine of the University of Porto.</p>
			</div>
			<nav class="footer-nav" aria-label="{{ 'Rodapé' if pt else 'Footer' }}">
				<ul>
					<li><a href="/install/">Install</a></li>
					<li><a href="/guide/">Guide</a></li>
					<li><a href="/profiles/">Profiles</a></li>
					<li><a href="/models/">Models</a></li>
				</ul>
				<ul>
					<li><a href="/privacy/">Privacy</a></li>
					<li><a href="/help/">Help</a></li>
					<li><a href="/fmup/">FMUP</a></li>
					<li><a href="/about/">About</a></li>
				</ul>
				<ul>
					<li><a href="{{ site.repo }}" rel="noopener">GitHub</a></li>
					<li><a href="{{ site.npm }}" rel="noopener">npm</a></li>
					<li><a href="{{ site.serverRepo }}" rel="noopener">Zotero server</a></li>
					<li><a href="{{ site.repo }}/issues" rel="noopener">Report a problem</a></li>
				</ul>
			</nav>
		</div>
		<div class="wrap footer-versions">
			<span>Sub-Sub {{ release.version }}</span>
			<span>zotero-local-mcp {{ release.server }}</span>
			<span>Starbuck {{ release.starbuck }}</span>
			<span>pi {{ release.pi | replace("^", "") }}</span>
		</div>
	</footer>
</body>
</html>
