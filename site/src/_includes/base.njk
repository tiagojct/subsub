{%- set pt = lang == "pt-PT" -%}
{%- set home = "/pt/" if pt else "/" -%}
{%- set L = strings.pt if pt else strings.en -%}
<!doctype html>
<html lang="{{ lang or 'en' }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title and title != site.title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}: {{ L.tagline }}{% endif %}</title>
	<meta name="description" content="{{ description or site.description }}">
	{% if noindex %}<meta name="robots" content="noindex">
	{% endif %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">
	{%- if alt %}
	<link rel="alternate" hreflang="{{ 'en' if pt else 'pt-PT' }}" href="{{ site.url }}{{ alt }}">
	<link rel="alternate" hreflang="{{ 'pt-PT' if pt else 'en' }}" href="{{ site.url }}{{ page.url }}">
	<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alt if pt else page.url }}">
	{%- endif %}
	<meta name="color-scheme" content="light dark">
	<meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)">
	<meta name="theme-color" content="#141413" media="(prefers-color-scheme: dark)">
	<meta property="og:title" content="{{ title or site.title }}">
	<meta property="og:description" content="{{ description or site.description }}">
	<meta property="og:url" content="{{ site.url }}{{ page.url }}">
	<meta property="og:type" content="website">
	<meta property="og:locale" content="{{ 'pt_PT' if pt else 'en_GB' }}">
	<meta property="og:image" content="{{ site.url }}/assets/img/og{{ '-pt' if pt }}.png">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta name="twitter:card" content="summary_large_image">
	{%- if bodyClass == "home" %}
	<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "SoftwareApplication", "name": "Sub-Sub", "applicationCategory": "ResearchApplication", "operatingSystem": "macOS, Windows, Linux", "softwareVersion": release.version, "license": "https://opensource.org/licenses/MIT", "url": site.url, "description": description or site.description, "inLanguage": ["en", "pt-PT"], "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }, "author": { "@type": "Person", "name": "Tiago Jacinto", "affiliation": { "@type": "CollegeOrUniversity", "name": "Faculdade de Medicina da Universidade do Porto" } }, "codeRepository": site.repo, "identifier": "https://doi.org/" + site.doi } | dump | safe }}</script>
	{%- endif %}
	<link rel="icon" href="/assets/favicon.svg?v={{ assetVersion }}" type="image/svg+xml">
	<link rel="preload" href="/assets/fonts/IBMPlexSans.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="preload" href="/assets/fonts/IBMPlexSerif.woff2" as="font" type="font/woff2" crossorigin>
	<link rel="stylesheet" href="/assets/css/site.css?v={{ assetVersion }}">
	<script>
		// Set the theme before the first paint: the saved choice, or the system setting.
		try {
			var saved = localStorage.getItem("subsub-site-theme");
			if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
		} catch (e) {}
	</script>
	<script src="/assets/js/site.js?v={{ assetVersion }}" defer></script>
</head>
<body class="{{ bodyClass or 'page' }}">
	<a class="skip" href="#main">{{ L.skip }}</a>

	<header class="site-header">
		<div class="wrap header-inner">
			<a class="brand" href="{{ home }}">
				<svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M6.5 9h7M6.5 12h11"/><circle cx="12" cy="16" r="1.1"/></svg>
				<span>Sub<span class="hyphen">-</span>Sub</span>
			</a>
			<nav class="nav" id="site-nav" aria-label="{{ L.mainMenu }}">
				<ul>
				{%- for item in nav %}
					{%- set url = item.ptUrl if pt else item.url %}
					<li><a href="{{ url }}"{% if page.url == url %} aria-current="page"{% endif %}>{{ item.ptLabel if pt else item.label }}</a></li>
				{%- endfor %}
				</ul>
			</nav>
			<div class="header-tools">
				{%- if alt %}
				<a class="tool-link lang-link" href="{{ alt }}" hreflang="{{ 'en' if pt else 'pt-PT' }}" lang="{{ 'en' if pt else 'pt-PT' }}" title="{{ 'Read this page in English' if pt else 'Ler esta página em português' }}">{{ "EN" if pt else "PT" }}</a>
				{%- endif %}
				<a class="tool-link gh-link" href="{{ site.repo }}" rel="noopener">GitHub</a>
				<button type="button" class="theme-btn menu-btn" id="menu-toggle" aria-controls="site-nav" aria-expanded="false" aria-label="{{ L.menu }}">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
				</button>
				<button type="button" class="theme-btn" id="theme-toggle" aria-label="{{ L.theme }}">
					<svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
					<svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
				</button>
			</div>
		</div>
	</header>

	{% if bodyClass == "home" %}
		<main id="main">
			{{ content | safe }}
		</main>
	{% else %}
		<main id="main" class="wrap doc">
			{%- if title and not hideTitle %}
			<header class="doc-header">
				{% if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
				<h1>{{ title }}</h1>
				{% if lead %}<p class="lead">{{ lead }}</p>{% endif %}
			</header>
			{%- endif %}
			<div class="doc-body">
				<article class="prose">
					{{ content | safe }}
				</article>
				<aside class="toc" id="toc" hidden>
					<p class="toc-title">{{ L.onThisPage }}</p>
					<ol></ol>
				</aside>
			</div>
		</main>
	{% endif %}

	<footer class="site-footer">
		<div class="wrap footer-inner">
			<div class="footer-about">
				<a class="brand" href="{{ home }}">
					<svg class="mark" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M6.5 9h7M6.5 12h11"/><circle cx="12" cy="16" r="1.1"/></svg>
					<span>Sub<span class="hyphen">-</span>Sub</span>
				</a>
				<p>{{ L.footerAbout | safe }}</p>
				<p class="cite"><span class="cite-label">{{ L.citeAs }}</span> Jacinto T. Sub-Sub: {{ L.citeTitle }} [software]. <a href="{{ site.npm }}" rel="noopener">{{ L.version }} {{ release.version }}</a>. Porto: Faculdade de Medicina da Universidade do Porto; 2026. doi:<a href="https://doi.org/{{ site.doi }}" rel="noopener">{{ site.doi }}</a>. {{ L.licence }}</p>
			</div>
			<nav class="footer-nav" aria-label="{{ L.footer }}">
				{%- for col in [nav.slice(0, 5), nav.slice(5)] %}
				<ul>
					{%- for item in col %}
					<li><a href="{{ item.ptUrl if pt else item.url }}">{{ item.ptLabel if pt else item.label }}</a></li>
					{%- endfor %}
				</ul>
				{%- endfor %}
				<ul>
					<li><a href="{{ site.repo }}" rel="noopener">GitHub</a></li>
					<li><a href="{{ site.npm }}" rel="noopener">npm</a></li>
					<li><a href="{{ site.serverRepo }}" rel="noopener">{{ L.zoteroServer }}</a></li>
					<li><a href="{{ site.repo }}/issues" rel="noopener">{{ L.report }}</a></li>
				</ul>
			</nav>
		</div>
		<div class="wrap footer-versions">
			<span>Sub-Sub {{ release.version }}</span>
			<span>zotero-local-mcp {{ release.server }}</span>
			<span>Starbuck {{ release.starbuck }}</span>
			<span>pi {{ release.pi | replace("^", "") }}</span>
		</div>
	</footer>
</body>
</html>
