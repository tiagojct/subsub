<!-- Section: Profiles for How You Work -->
<section class="vintage-section" style="padding-top: 1rem;">
	<div class="section-head">
		<div class="section-numeral">IV. Calibrated Autonomy</div>
		<h2 class="section-heading">Profiles</h2>
		<p class="section-sublead">
			A profile sets how much Sub-Sub does for you. Switch anytime with <code>/profile &lt;name&gt;</code>.
		</p>
	</div>

	<div class="profiles-table-wrap">
		<table>
			<thead>
				<tr>
					<th>Profile</th>
					<th>Operational Scope</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td class="col-profile">Reader</td>
					<td>Guided and pedagogical. Reading notes are quotes with page numbers and questions for you. Never generates unrequested summaries.</td>
				</tr>
				<tr>
					<td class="col-profile">Scholar</td>
					<td>Literature notes, conceptual syntheses, gap searches, alerts, and the full librarian toolkit.</td>
				</tr>
				<tr>
					<td class="col-profile">Author</td>
					<td>Scholar, plus manuscript auditing: citation verification against your library, automated bibliographies, and argument analysis.</td>
				</tr>
				<tr>
					<td class="col-profile">Editor</td>
					<td>Everything unlocked, including drafting manuscript text and abstracts upon request.</td>
				</tr>
			</tbody>
		</table>
	</div>

	<p style="text-align: center;">
		<a href="/profiles/">About profiles →</a>
	</p>
</section>

